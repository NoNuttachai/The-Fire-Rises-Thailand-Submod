guiTypes = {
	# =============================================
	# Thailand House of Representatives Parliament GUI
	# Embedded in decision category panel
	# =============================================
	containerWindowType = {
		name = "SIA_parliament_gui_window"
		position = { x = 0 y = 0 }
		size = { width = 470 height = 820 }

		# =============================================
		# TOP: Description Text
		# =============================================
		instantTextBoxType = {
			name = "parliament_desc"
			position = { x = 5 y = 5 }
			font = "hoi_18"
			maxwidth = 460
			maxHeight = 80
			text = SIA_parliament_house_desc
			format = left
			scrollbartype = standardtext_slider
		}

		# =============================================
		# ROW: Speaker Portrait (left) + Donut Chart (right)
		# =============================================
		iconType = {
			name = "speaker_portrait"
			quadTextureSprite = "GFX_SIA_speaker_portrait"
			position = { x = 5 y = 88 }
		}

		iconType = {
			name = "parliament_donut"
			quadTextureSprite = "GFX_SIA_parliament_donut"
			position = { x = 170 y = 88 }
		}

		# =============================================
		# SEAT BAR — 3-color strip (gov / opp / vacant)
		# =============================================
		containerWindowType = {
			name = "SIA_seat_bar_container"
			position = { x = 5 y = 273 }
			size = { width = 460 height = 28 }
			clipping = yes

			iconType = {
				name = "seat_bar_gov"
				spriteType = "GFX_SIA_seat_gov"
				position = { x = 0 y = 0 }
				scale = "[Divide(SIA_parliament_gov_seats,1.0)]"
			}
			iconType = {
				name = "seat_bar_opp"
				spriteType = "GFX_SIA_seat_opp"
				position = { x = 0 y = 0 }
				scale = "[Divide(SIA_parliament_opp_seats,1.0)]"
			}
			iconType = {
				name = "seat_bar_vacant"
				spriteType = "GFX_SIA_seat_vacant"
				position = { x = 0 y = 0 }
				scale = "[Divide(SIA_parliament_vacant_seats,1.0)]"
			}
		}

		# Seat bar labels
		instantTextBoxType = {
			name = "seat_bar_gov_label"
			position = { x = 5 y = 303 }
