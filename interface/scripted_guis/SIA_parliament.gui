guiTypes = {
	# =============================================
	# Thailand House of Representatives Parliament GUI
	# Embedded in decision category panel
	# =============================================
	containerWindowType = {
		name = "SIA_parliament_gui_window"
		position = { x = 0 y = 0 }
		size = { width = 470 height = 680 }

		iconType = {
			name = "parliament_bg"
			spriteType = "GFX_SIA_parliament_bg"
			position = { x = 15 y = 180 }
		}
		containerWindowType = {
			name = "SIA_parliament_gui_main_window"
			position = { x = 0 y = -100 }
			# =============================================
			# TOP: Description Text
			# =============================================
			iconType = {
				name = "parliament_help_icon"
				spriteType = "GFX_icon_question_mark"
				pdx_tooltip  = "SIA_parliament_house_desc"
				position = { x = 450 y = 85 }
				scale = 0.7
			}

			# =============================================
			# ROW: Speaker Portrait (left) + Donut Chart (right)
			# =============================================
			iconType = {
				name = "speaker_portrait"
				quadTextureSprite = "GFX_SIA_speaker_portrait"
				position = { x = 50 y = 130 }
				scale = 0.8
				pdx_tooltip = SIA_parliament_speaker_desc
			}
			
			iconType = {
				name = "parliament_donut_outline"
				quadTextureSprite = "GFX_SIA_parliament_donut_outline"
				position = { x = 190 y = 145 }
			}
			iconType = {
				name = "parliament_donut_gov"
				quadTextureSprite = "GFX_SIA_parliament_donut_blue"
				position = { x = 190 y = 120 }
			}
			iconType = {
				name = "parliament_donut_opposition"
				quadTextureSprite = "GFX_SIA_parliament_donut_red"
				position = { x = 190 y = 120 }
			}
			iconType = {
				name = "parliament_donut_vacant"
				quadTextureSprite = "GFX_SIA_parliament_donut_gray"
				position = { x = 190 y = 120 }
			}
			
			

			# =============================================
			# Total Government Seats (centered)
			# =============================================
			instantTextBoxType = {
				name = "gov_seats_total"
				position = { x = 5 y = 310 }
				font = "VCR02_14"
				maxwidth = 460
				text = SIA_parliament_gov_support_loc
				format = center
			}
			# =============================================
			# Total Opposition Seats (centered)
			# =============================================
			instantTextBoxType = {
				name = "opp_seats_total"
				position = { x = 5 y = 540 }
				font = "VCR02_14"
				maxwidth = 460
				text = SIA_parliament_opp_support_loc
				format = center
			}
			
			containerWindowType = {
				name = "SIA_parliament_gui_parties"
				position = { x = 10 y = 0 }
				# =============================================
				# GOVERNMENT PARTIES
				# =============================================
				gridBoxType = {
					name = "government_parties_gridbox"
					position = { x = -165 y = 0 }
					size = {
						width = 460 height = 45
					}
					slotsize = {
						width = 100 height = 35
					}
					max_slots_horizontal = 1
					add_horizontal = no
				}
				
				# =============================================
				# OPPOSITION PARTIES
				# =============================================
				gridBoxType = {
					name = "Opposition_parties_gridbox"
					position = { x = -165 y = 230 }
					size = {
						width = 460 height = 45
					}
					slotsize = {
						width = 100 height = 35
					}
					max_slots_horizontal = 1
					add_horizontal = no
				}
			}
			# Vacant Seats
			instantTextBoxType = {
				name = "vacant_seats_total"
				position = { x = 5 y = 746 }
				font = "VCR02_14"
				maxwidth = 460
				text = SIA_parliament_vacant_seats_text
				format = center
			}
		}
	}
	containerWindowType = {
		name = "SIA_parliament_party_container"

		position = {
			x = 0 y = 0
		}
		size = {
			width = 0
			height = 0
		}
		instantTextBoxType = {
			name = "party_name"
			position = { x = 5 y = 331 }
			font = "VCR02_14"
			maxwidth = 460
			text = [SIA_party_line]
			pdx_tooltip = SIA_parliament_desc
			format = left
		}
		
	}
}
